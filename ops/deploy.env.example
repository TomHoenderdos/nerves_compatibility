# The host layout the deploy scripts use (ops/deploy.sh, build-release.sh,
# builder-deploy.sh, images-sync.sh and, over ssh, deploy-builders.sh). Copy
# it to /etc/ncc-deploy.env on every host that runs them (root-owned, mode
# 0644) and set real paths; the scripts refuse to run without it. Sourced by
# bash with `set -a`, so plain KEY=value lines only. NCC_DEPLOY_ENV names
# another file, for tests.

# The git checkout of main that deploys fast-forward.
NCC_SRC_DIR=/srv/example/src
# Holds the installed deploy.sh and build-release.sh, the release (portal/),
# deploy.lock and portal-previous.tar.gz.
NCC_INSTALL_DIR=/srv/example
# The release's environment file; its NCC_* settings decide this node's role.
NCC_PORTAL_ENV=/etc/example/portal.env
# The directory the release's eval and rpc run in, readable by its user.
NCC_PORTAL_WORKDIR=/srv/example/home

# Web host only: where images-sync.sh installs images.json. Set the release's
# own NCC_IMAGES_JSON (in NCC_PORTAL_ENV) to the same path.
NCC_IMAGES_JSON=/etc/example/images.json

# The daemon the deploy talks to, as root; build-release.sh and
# builder-deploy.sh refuse without it rather than fall back to a default.
# Build hosts: docker-ncc's root-only unix socket, where build-release.sh
# builds the release and builder-deploy.sh pulls, builds, loads and tags the
# worker images. The build egress filter is the host's NixOS configuration;
# no deploy script installs or loads it.
DOCKER_HOST=unix:///run/docker-ncc/docker.sock
# The web host has no docker-ncc: it builds the release on its system dockerd.
#DOCKER_HOST=unix:///var/run/docker.sock
