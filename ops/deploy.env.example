# The host layout the deploy scripts use (ops/deploy.sh, build-release.sh,
# builder-deploy.sh, builder-egress-load.sh, images-sync.sh and, over ssh,
# deploy-builders.sh). Copy it to /etc/ncc-deploy.env on every host that runs
# them (root-owned, mode 0644: the egress loader reads it as the daemon's
# user) and set real paths; the scripts refuse to run without it. Sourced by
# bash with `set -a`, so plain KEY=value lines only. NCC_DEPLOY_ENV names
# another file, for tests.

# The git checkout of main that deploys fast-forward.
NCC_SRC_DIR=/srv/example/src
# Holds the installed deploy.sh, build-release.sh and builder-egress-load.sh,
# the release (portal/), deploy.lock and portal-previous.tar.gz.
NCC_INSTALL_DIR=/srv/example
# The release's environment file; its NCC_* settings decide this node's role.
NCC_PORTAL_ENV=/etc/example/portal.env
# The directory the release's eval and rpc run in, readable by its user.
NCC_PORTAL_WORKDIR=/srv/example/home

# Web host only: where images-sync.sh installs images.json. Set the release's
# own NCC_IMAGES_JSON (in NCC_PORTAL_ENV) to the same path.
NCC_IMAGES_JSON=/etc/example/images.json

# Build hosts only: where builder-deploy.sh installs the egress rulesets and
# where builder-egress-load.sh reads them.
NCC_EGRESS_RULESET=/etc/example/builder-egress.nft
NCC_EGRESS_BRIDGE_RULESET=/etc/example/builder-egress-bridge.nft
