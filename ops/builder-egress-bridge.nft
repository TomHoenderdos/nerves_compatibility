#!/usr/sbin/nft -f
# Container-to-container traffic on the build bridge (isolation spec,
# section 3: no container needs another). Frames between two ports of one
# bridge are switched, never routed, so ops/builder-egress.nft's forward
# chain never sees them; this bridge-family table does.
#
# Loaded best effort by ops/builder-egress-load.sh: it needs nft_meta_bridge,
# which the namespace cannot load itself. A kernel without it loses only this
# table, not the egress filter, and the loader says so.
define ncc_bridge = "docker0"

table bridge ncc_egress {}
delete table bridge ncc_egress

table bridge ncc_egress {
	chain build_icc {
		type filter hook forward priority filter - 10; policy accept;

		meta ibrname $ncc_bridge drop comment "ncc_egress_icc_v1"
	}
}
