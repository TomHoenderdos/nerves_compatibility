<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Failure Clusters — Nerves Compatibility</title>
  <style>
    <%= Site.Nav.css() %>
    .topbar { margin-bottom: 24px; }
    .topbar a { color: #5e2ca5; margin-right: 16px; }
    h1 { margin-bottom: 6px; }
    .summary { color: #6b7280; margin-bottom: 30px; font-size: 1.05em; }
    .cluster { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 22px; margin-bottom: 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); }
    .cluster-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 10px; }
    .cluster-title { font-size: 1.2em; font-weight: 700; color: #991b1b; }
    .cluster-count { background: #fee2e2; color: #991b1b; padding: 4px 12px; border-radius: 14px; font-weight: 700; font-size: 0.95em; white-space: nowrap; }
    .cluster-hint { color: #4b5563; margin: 8px 0 14px; font-size: 0.96em; line-height: 1.5; }
    .cluster-meta { color: #6b7280; font-size: 0.88em; margin-bottom: 14px; }
    .cluster-meta .sys { display: inline-block; background: #f3f4f6; padding: 2px 8px; border-radius: 4px; margin-right: 5px; font-family: ui-monospace, monospace; font-size: 0.9em; }
    details { margin-top: 8px; }
    details summary { cursor: pointer; color: #5e2ca5; font-size: 0.95em; user-select: none; }
    details summary:hover { text-decoration: underline; }
    .pkg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 6px 20px; margin-top: 10px; }
    .pkg-row { font-size: 0.92em; padding: 3px 0; }
    .pkg-row a { color: #5e2ca5; }
    .pkg-row .sys-tag { color: #6b7280; font-family: ui-monospace, monospace; font-size: 0.88em; }
    pre.log { background: #0f172a; color: #e5e7eb; padding: 14px; border-radius: 6px; overflow-x: auto; font-size: 0.8em; line-height: 1.5; margin-top: 12px; }
    .empty { color: #6b7280; font-style: italic; padding: 20px 0; text-align: center; }
  </style>
</head>
<body>
  <%= @nav_html %>
  <main class="page">

  <h1>Failure clusters</h1>
  <p class="subtitle">Every failing system-result grouped by the root-cause signature found in its build log. Clusters are ranked by count — fixing the cluster at the top unblocks the most packages at once.</p>

  <%= if Enum.empty?(@clusters) do %>
    <p class="empty">No failures yet! Either nothing's been scanned or everything passed.</p>
  <% else %>
    <%= for cluster <- @clusters do %>
      <section class="cluster">
        <div class="cluster-head">
          <div class="cluster-title"><%= cluster.title %></div>
          <div class="cluster-count"><%= cluster.count %> failures · <%= cluster.unique_packages %> package<%= if cluster.unique_packages != 1, do: "s" %></div>
        </div>
        <div class="cluster-hint"><%= cluster.hint %></div>
        <% lang_counts = cluster.entries
          |> Enum.map(& &1[:nif_language])
          |> Enum.reject(&is_nil/1)
          |> Enum.frequencies()
          |> Enum.sort_by(fn {_lang, c} -> -c end) %>
        <div class="cluster-meta">
          Affecting
          <%= for sys <- cluster.affected_systems do %>
            <span class="sys"><%= sys %></span>
          <% end %>
          <%= if lang_counts != [] do %>
            <span style="margin-left: 8px;">· NIF language breakdown:</span>
            <%= for {lang, n} <- lang_counts do %>
              <span class="sys" style="background: #fef3c7; color: #78350f;"><%= lang %> × <%= n %></span>
            <% end %>
          <% end %>
        </div>

        <details>
          <summary>Show <%= length(cluster.entries) %> affected package<%= if length(cluster.entries) != 1, do: "s" %></summary>
          <div class="pkg-grid">
            <%= for entry <- cluster.entries do %>
              <% pkg_href =
                if entry[:version] do
                  "packages/#{String.replace("#{entry.package}@#{entry.version}", "/", "_")}.html"
                else
                  "packages/#{String.replace(entry.package, "/", "_")}.html"
                end %>
              <div class="pkg-row">
                <a href="<%= pkg_href %>"><code><%= entry.package %></code></a>
                <span class="sys-tag" title="<%= entry.system %>"><%= Site.Architecture.label(entry.system) %></span>
                <%= if entry[:nif_language] do %>
                  <span style="display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 0.78em; font-weight: 600; background: #fef3c7; color: #78350f; margin-left: 4px;"><%= entry.nif_language %></span>
                <% end %>
                <%= if entry.detail do %>
                  <div style="color: #4b5563; font-size: 0.88em; font-family: ui-monospace, monospace; padding-left: 10px; word-break: break-all;"><%= entry.detail %></div>
                <% end %>
              </div>
            <% end %>
          </div>
        </details>

        <%= if cluster.sample_log do %>
          <details>
            <summary>Representative log excerpt</summary>
            <pre class="log"><%= cluster.sample_log %></pre>
          </details>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <footer>
    <p>Signatures are heuristic — patterns live in <code>site/lib/site/failure_cluster.ex</code>.</p>
  </footer>
  </main>
</body>
</html>
