<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Warnings — Nerves Compatibility</title>
  <style>
    <%= Site.Nav.css() %>
    .warn { background: #fff; border: 1px solid #e5e7eb; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 22px; margin-bottom: 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); }
    .warn-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 8px; }
    .warn-title { font-size: 1.15em; font-weight: 700; color: #92400e; }
    .warn-count { padding: 4px 12px; border-radius: 14px; font-weight: 700; font-size: 0.92em; white-space: nowrap; background: #fef3c7; color: #92400e; }
    .warn-hint { color: #4b5563; margin-bottom: 14px; font-size: 0.96em; line-height: 1.5; }
    details summary { cursor: pointer; color: #5e2ca5; font-size: 0.95em; user-select: none; }
    details summary:hover { text-decoration: underline; }
    .pkg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 6px 20px; margin-top: 10px; }
    .pkg-row { font-size: 0.92em; padding: 4px 0; }
    .pkg-row a { color: #5e2ca5; }
    .pkg-row .evidence { color: #6b7280; font-size: 0.85em; font-family: ui-monospace, monospace; padding-left: 12px; word-break: break-all; }
    .empty { color: #6b7280; font-style: italic; padding: 20px 0; text-align: center; background: #fff; border-radius: 8px; border: 1px solid #e5e7eb; }
  </style>
</head>
<body>
  <%= @nav_html %>
  <main class="page">

  <h1>Warnings</h1>
  <p class="subtitle">Non-fatal quality signals detected by the BEAM scanner. These packages compile and pass — but use patterns worth knowing about for Nerves firmware (reproducibility, runtime behavior, host-tool dependencies).</p>

  <%= if Enum.empty?(@warnings) do %>
    <p class="empty">No warnings detected — every scanned package is clean. (Or no packages have been scanned yet.)</p>
  <% else %>
    <%= for warning <- @warnings do %>
      <section class="warn">
        <div class="warn-head">
          <div class="warn-title"><%= warning.title %></div>
          <div class="warn-count"><%= warning.count %> package<%= if warning.count != 1, do: "s" %></div>
        </div>
        <div class="warn-hint"><%= warning.hint %></div>

        <details>
          <summary>Show <%= warning.count %> affected package<%= if warning.count != 1, do: "s" %></summary>
          <div class="pkg-grid">
            <%= for entry <- warning.entries do %>
              <div class="pkg-row">
                <a href="<%= entry.link %>"><code><%= entry.package %></code></a>
                <%= if entry.version do %>
                  <span style="color: #9ca3af; font-size: 0.85em;">@<%= entry.version %></span>
                <% end %>
                <%= for ev <- entry.evidence do %>
                  <div class="evidence"><%= ev %></div>
                <% end %>
              </div>
            <% end %>
          </div>
        </details>
      </section>
    <% end %>
  <% end %>

  <footer>
    <p>Warning rules live in <code>site/lib/site/warning_cluster.ex</code> — propose new rules as new entries there.</p>
  </footer>
  </main>
</body>
</html>
