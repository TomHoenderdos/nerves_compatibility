{application,circuits_gpio,
             [{modules,['Elixir.Circuits.GPIO','Elixir.Circuits.GPIO.Backend',
                        'Elixir.Circuits.GPIO.CDev',
                        'Elixir.Circuits.GPIO.Diagnostics',
                        'Elixir.Circuits.GPIO.Handle',
                        'Elixir.Circuits.GPIO.Handle.Circuits.GPIO.CDev',
                        'Elixir.Circuits.GPIO.Nif',
                        'Elixir.Circuits.GPIO.NilBackend']},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger]},
              {description,"Use GPIOs in Elixir"},
              {registered,[]},
              {vsn,"2.1.3"},
              {env,[{default_backend,'Elixir.Circuits.GPIO.CDev'}]}]}.
