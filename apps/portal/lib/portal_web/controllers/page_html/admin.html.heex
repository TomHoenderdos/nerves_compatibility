<.admin_layout flash={@flash} current_user={@current_user} section={:overview} title="Overview">
  <:subtitle>What needs attention, with a way into each section.</:subtitle>
  <div id="admin-overview" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <.link href={~p"/admin/queue"} class="block">
      <PortalWeb.UI.stat_card label="Needs review" value={to_string(@review_total)} />
    </.link>
    <.link href={~p"/admin/queue"} class="block">
      <PortalWeb.UI.stat_card label="Current queue" value={to_string(@queue_total)} />
    </.link>
    <.link href={~p"/admin/users"} class="block">
      <PortalWeb.UI.stat_card label="Admins" value={to_string(@admin_count)} />
    </.link>
    <.link href={~p"/admin/argus/findings"} class="block">
      <PortalWeb.UI.stat_card label="New argus findings" value={to_string(@triage_counts.new)} />
    </.link>
    <.link href={~p"/admin/maintenance"} class="block">
      <PortalWeb.UI.stat_card
        label="Update check"
        value={if @update_check.enabled?, do: "scheduled", else: "off"}
      />
    </.link>
  </div>

  <section class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <h2 class="card-title">Recent failures</h2>
        <.link href={~p"/admin/failures"} class="link text-sm">All failures →</.link>
      </div>
      <p :if={@failures == []} class="mt-2 text-sm text-base-content/60">No failed requests.</p>
      <ul :if={@failures != []} class="mt-2 divide-y divide-base-200">
        <li :for={failure <- @failures} class="flex flex-wrap items-center gap-2 py-2 text-sm">
          <.link
            navigate={~p"/packages/#{failure.package_name}"}
            class="link font-mono font-medium"
          >
            {failure.package_name}
          </.link>
          <span class="text-base-content/60">{failure.error_reason}</span>
          <span class="text-xs text-base-content/50">{format_datetime(failure.failed_at)}</span>
        </li>
      </ul>
    </div>
  </section>
</.admin_layout>
