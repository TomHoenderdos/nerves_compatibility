<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-100 text-base-content">
  <.site_nav active={:admin} current_user={@current_user} />

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="space-y-8">
      <PortalWeb.UI.page_header kicker="Admin" title="Scan request operations">
        <:subtitle>
          Review anonymous submissions and inspect accepted requests waiting for scanner processing.
        </:subtitle>
      </PortalWeb.UI.page_header>

      <div class="grid gap-3 sm:grid-cols-2">
        <PortalWeb.UI.stat_card
          label="Needs review"
          value={to_string(@review_page.total)}
        />
        <PortalWeb.UI.stat_card label="Current queue" value={to_string(@queue_page.total)} />
      </div>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="card-title">Queue a scan</h2>
              <p class="mt-1 text-sm leading-6 text-base-content/70">
                Goes straight into the queue at the highest priority. No approval step.
              </p>
            </div>
            <span class="badge badge-outline w-fit">Admin</span>
          </div>

          <form method="post" action={~p"/admin/scan"} class="mt-5 flex flex-col gap-3">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <.admin_page_fields queue_page={@queue_page.page} review_page={@review_page.page} />
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
              <label class="form-control w-full sm:max-w-sm">
                <span class="label-text">Package name</span>
                <input
                  type="text"
                  name="package_name"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="nerves_system_rpi4"
                  class="input input-bordered w-full font-mono"
                />
              </label>
              <button type="submit" class="btn btn-primary">Queue scan</button>
            </div>
            <label class="flex items-center gap-2 text-sm text-base-content/70">
              <input type="checkbox" name="force" value="true" class="checkbox checkbox-sm" />
              <span>
                Force a rebuild even if this version was already built. Costs a full firmware build.
              </span>
            </label>
          </form>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="card-title">Anonymous approvals</h2>
              <p class="mt-1 text-sm leading-6 text-base-content/70">
                These requests need a human check before queue promotion.
              </p>
            </div>
            <span class="badge badge-outline w-fit">Manual review</span>
          </div>

          <%= if @pending_anonymous_requests == [] do %>
            <p class="mt-5 text-sm leading-6 text-base-content/70">
              No anonymous requests are waiting for approval.
            </p>
          <% else %>
            <div class="mt-5 overflow-x-auto">
              <table id="approvals" class="table">
                <thead>
                  <tr>
                    <th>Package</th>
                    <th>Requested by</th>
                    <th>Submitted</th>
                    <th class="text-right">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={request <- @pending_anonymous_requests}>
                    <td class="font-mono">{request.package_name}</td>
                    <td>{request.subject || "anonymous"}</td>
                    <td>{format_datetime(request.inserted_at)}</td>
                    <td>
                      <div class="flex justify-end gap-2">
                        <form method="post" action={~p"/admin/requests/#{request.id}/reject"}>
                          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                          <.admin_page_fields
                            queue_page={@queue_page.page}
                            review_page={@review_page.page}
                          />
                          <button type="submit" class="btn btn-sm btn-ghost text-error">
                            Reject
                          </button>
                        </form>
                        <form method="post" action={~p"/admin/requests/#{request.id}/approve"}>
                          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                          <.admin_page_fields
                            queue_page={@queue_page.page}
                            review_page={@review_page.page}
                          />
                          <button type="submit" class="btn btn-sm btn-primary">
                            Approve
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% end %>
          <.admin_pagination
            id="approvals-pagination"
            label="Anonymous approvals pages"
            page={@review_page}
            params={@page_params}
            param={:review_page}
          />
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="card-title">Current queue</h2>
              <p class="mt-1 text-sm leading-6 text-base-content/70">
                Accepted portal requests are shown oldest first. Pending anonymous requests stay out of this list until approved.
              </p>
            </div>
            <span class="badge badge-primary w-fit">Accepted</span>
          </div>

          <%= if @queue_requests == [] do %>
            <p class="mt-5 text-sm leading-6 text-base-content/70">
              No accepted portal requests are currently queued.
            </p>
          <% else %>
            <div class="mt-5 overflow-x-auto">
              <table id="queue" class="table">
                <thead>
                  <tr>
                    <th>Package</th>
                    <th>Verification</th>
                    <th>Status</th>
                    <th>Subject</th>
                    <th>Submitted</th>
                    <th class="text-right">Queue position</th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={request <- @queue_requests}>
                    <td class="font-mono">{request.package_name}</td>
                    <td>{verification_label(request.source)}</td>
                    <td>
                      <span class="badge badge-outline">
                        {request_status_label(request.status)}
                      </span>
                    </td>
                    <td>{request.subject || "-"}</td>
                    <td>{format_datetime(request.inserted_at)}</td>
                    <td>
                      <% position = @queue_positions[request.id] %>
                      <%= if position do %>
                        <div class="flex items-center justify-end gap-2">
                          <span class="badge badge-ghost font-mono" title={position.state}>
                            P{position.priority}
                          </span>
                          <form
                            method="post"
                            action={~p"/admin/requests/#{request.id}/priority"}
                            class="contents"
                          >
                            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                            <.admin_page_fields
                              queue_page={@queue_page.page}
                              review_page={@review_page.page}
                            />
                            <input type="hidden" name="direction" value="up" />
                            <button
                              type="submit"
                              class="btn btn-xs btn-ghost"
                              disabled={not position.adjustable? or position.priority == 0}
                              title="Run sooner"
                            >
                              &uarr;
                            </button>
                          </form>
                          <form
                            method="post"
                            action={~p"/admin/requests/#{request.id}/priority"}
                            class="contents"
                          >
                            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                            <.admin_page_fields
                              queue_page={@queue_page.page}
                              review_page={@review_page.page}
                            />
                            <input type="hidden" name="direction" value="down" />
                            <button
                              type="submit"
                              class="btn btn-xs btn-ghost"
                              disabled={not position.adjustable? or position.priority == 9}
                              title="Run later"
                            >
                              &darr;
                            </button>
                          </form>
                        </div>
                      <% else %>
                        <span class="text-sm text-base-content/50">building</span>
                      <% end %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% end %>
          <.admin_pagination
            id="queue-pagination"
            label="Current queue pages"
            page={@queue_page}
            params={@page_params}
            param={:queue_page}
          />
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="card-title">hex.pm update check</h2>
              <p class="mt-1 text-sm leading-6 text-base-content/70">
                Runs hourly, compares tracked packages against the hex.pm registry, and queues every eligible update. Pure-Elixir packages skip firmware builds after host checks.
              </p>
            </div>
            <span class={[
              "badge w-fit",
              if(@update_check.enabled?, do: "badge-success", else: "badge-error")
            ]}>
              {if @update_check.enabled?, do: "Scheduled", else: "Schedule off"}
            </span>
          </div>

          <%= if @update_check.last_run do %>
            <% meta = @update_check.last_run.meta %>
            <div class="mt-5 grid gap-3 sm:grid-cols-3">
              <PortalWeb.UI.stat_card label="On hex" value={to_string(meta["seen"])} />
              <PortalWeb.UI.stat_card label="Worth rebuilding" value={to_string(meta["moved"])} />
              <PortalWeb.UI.stat_card label="Queued" value={to_string(meta["enqueued"])} />
            </div>
            <p class="mt-3 text-sm leading-6 text-base-content/70">
              Last run {format_datetime(@update_check.last_run.completed_at)}
              <%= if meta["dry_run"] do %>
                , as a dry run -- nothing was queued
              <% end %>.
            </p>
          <% else %>
            <p class="mt-5 text-sm leading-6 text-base-content/70">
              No run has recorded any numbers yet.
            </p>
          <% end %>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            <form method="post" action={~p"/admin/update-check"}>
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <.admin_page_fields queue_page={@queue_page.page} review_page={@review_page.page} />
              <button
                type="submit"
                class="btn btn-sm btn-primary"
                disabled={@update_check.pending?}
              >
                Run now
              </button>
            </form>
            <form method="post" action={~p"/admin/update-check"}>
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <.admin_page_fields queue_page={@queue_page.page} review_page={@review_page.page} />
              <input type="hidden" name="mode" value="dry_run" />
              <button type="submit" class="btn btn-sm btn-ghost">Dry run</button>
            </form>
            <span class="text-sm text-base-content/60">
              <%= if @update_check.pending? do %>
                A check is already queued.
              <% else %>
                Either runs even while the schedule is off. A dry run queues nothing.
              <% end %>
            </span>
          </div>
        </div>
      </section>

      <section id="admins" class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <div>
            <h2 class="card-title">Admins</h2>
            <p class="mt-1 text-sm leading-6 text-base-content/70">
              Granting or revoking needs a passkey confirmed in the last {div(
                Portal.Accounts.Mfa.reauth_window_seconds(),
                60
              )} minutes on <.link navigate={~p"/settings/security"} class="link">your security settings</.link>.
              A new admin can only open this page once they have added a passkey.
            </p>
          </div>

          <ul class="mt-4 divide-y divide-base-200">
            <li
              :for={admin <- @admins}
              id={"admin-#{admin.id}"}
              class="flex items-center justify-between gap-3 py-2"
            >
              <div class="text-sm">
                <span class="font-medium">{admin.username}</span>
                <span :if={admin.hex_username} class="text-base-content/60">
                  · hex {admin.hex_username}
                </span>
                <span :if={!admin.passkey?} class="badge badge-sm badge-warning ml-2">
                  needs a passkey
                </span>
              </div>
              <form
                :if={admin.id != @current_user.id}
                method="post"
                action={~p"/admin/admins/#{admin.id}/revoke"}
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <button type="submit" class="btn btn-xs btn-ghost">Revoke</button>
              </form>
            </li>
          </ul>

          <form
            method="post"
            action={~p"/admin/admins"}
            class="mt-4 flex flex-wrap items-end gap-2"
          >
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <label class="text-sm">
              <span class="font-semibold">Grant admin to username</span>
              <input
                type="text"
                name="username"
                required
                autocomplete="off"
                class="input input-sm mt-1 block w-64"
              />
            </label>
            <button type="submit" class="btn btn-sm btn-primary">Grant admin</button>
          </form>
        </div>
      </section>

      <section id="argus-settings" class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <div>
            <h2 class="card-title">Static analysis (argus)</h2>
            <p class="mt-1 text-sm leading-6 text-base-content/70">
              argus_beam runs over each package's host beams. Its findings are internal for
              now: they show on the package page to admins only. Changes apply to builds
              started afterwards; the severity floor applies to the page immediately.
            </p>
            <.link
              navigate={~p"/admin/argus/findings"}
              class="link mt-2 inline-block text-sm font-medium"
            >
              Triage findings →
            </.link>
          </div>

          <form method="post" action={~p"/admin/argus"} class="mt-5 space-y-5">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <.admin_page_fields queue_page={@queue_page.page} review_page={@review_page.page} />

            <input type="hidden" name="argus[enabled]" value="false" />
            <label class="flex items-center gap-2 text-sm">
              <input
                type="checkbox"
                name="argus[enabled]"
                value="true"
                checked={@argus.argus_enabled}
                class="checkbox checkbox-sm"
              /> Run argus on new builds
            </label>

            <fieldset>
              <legend class="text-sm font-semibold">Analyses</legend>
              <div class="mt-2 grid gap-2 sm:grid-cols-3">
                <label
                  :for={name <- @argus_analysis_names}
                  class="flex items-center gap-2 text-sm"
                >
                  <input
                    type="checkbox"
                    name="argus[analyses][]"
                    value={name}
                    checked={name in @argus.argus_analyses}
                    class="checkbox checkbox-sm"
                  />
                  <span class="font-mono">{name}</span>
                </label>
              </div>
            </fieldset>

            <fieldset>
              <legend class="text-sm font-semibold">Scope</legend>
              <label class="mt-2 flex items-center gap-2 text-sm">
                <input
                  type="radio"
                  name="argus[scope]"
                  value="firmware"
                  checked={@argus.argus_scope == :firmware}
                  class="radio radio-sm"
                /> Firmware packages only
              </label>
              <label class="mt-1 flex items-center gap-2 text-sm">
                <input
                  type="radio"
                  name="argus[scope]"
                  value="all"
                  checked={@argus.argus_scope == :all}
                  class="radio radio-sm"
                /> All packages
              </label>
            </fieldset>

            <div class="flex flex-wrap gap-5">
              <label class="text-sm">
                <span class="font-semibold">Severity floor</span>
                <select name="argus[min_severity]" class="select select-sm mt-1 block">
                  <option
                    :for={s <- [:info, :warning, :error]}
                    value={s}
                    selected={@argus.argus_min_severity == s}
                  >
                    {s}
                  </option>
                </select>
              </label>
              <label class="text-sm">
                <span class="font-semibold">Timeout (seconds)</span>
                <input
                  type="number"
                  name="argus[timeout_seconds]"
                  min="30"
                  max="1800"
                  value={@argus.argus_timeout_seconds}
                  class="input input-sm mt-1 block w-32"
                />
              </label>
            </div>

            <button type="submit" class="btn btn-sm btn-primary">Save</button>
          </form>
        </div>
      </section>
    </section>
  </div>
</main>
