<.admin_layout flash={@flash} current_user={@current_user} section={:failures} title="Failures">
  <:subtitle>Builds that did not produce a result, newest first.</:subtitle>
  <section id="recent-failures" class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div>
        <h2 class="card-title">Recent failures</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          The 50 most recent requests whose build failed. A failed request leaves the queue; open it for
          the end of its build log.
        </p>
      </div>
      <p :if={@recent_failures == []} class="mt-3 text-sm text-base-content/60">
        No failed requests.
      </p>
      <ul :if={@recent_failures != []} class="mt-3 divide-y divide-base-200">
        <li :for={failure <- @recent_failures} id={"failure-#{failure.id}"} class="py-3">
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <.link navigate={~p"/requests/#{failure.id}"} class="link font-mono font-medium">
              {failure.package_name}{if failure.version, do: " #{failure.version}"}
            </.link>
            <span class="text-base-content/60">{failure.error_reason}</span>
            <span class="text-xs text-base-content/50">
              {format_datetime(failure.failed_at)}
            </span>
          </div>
          <pre
            :if={failure.summary}
            class="mt-1 overflow-x-auto font-mono text-xs leading-relaxed text-base-content/80"
          >{failure.summary}</pre>
        </li>
      </ul>
    </div>
  </section>
</.admin_layout>
