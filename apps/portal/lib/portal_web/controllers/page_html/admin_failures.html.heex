<.admin_layout flash={@flash} current_user={@current_user} section={:failures} title="Failures">
  <:subtitle>Builds that did not produce a result, newest first.</:subtitle>
  <section id="recent-failures" class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div>
        <h2 class="card-title">Recent failures</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          The 50 most recent requests whose build failed. A failed request leaves the queue; open it for
          the end of its build log.
        </p>
      </div>
      <p :if={@recent_failures == []} class="mt-3 text-sm text-base-content/60">
        No failed requests.
      </p>
      <ul :if={@recent_failures != []} class="mt-3 divide-y divide-base-200">
        <li :for={failure <- @recent_failures} id={"failure-#{failure.id}"} class="py-3">
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <.link
              navigate={~p"/packages/#{failure.package_name}"}
              class="link font-mono font-medium"
            >
              {failure.package_name}{if failure.version, do: " #{failure.version}"}
            </.link>
            <span class="text-base-content/60">{failure.error_reason}</span>
            <span class="text-xs text-base-content/50">
              {format_datetime(failure.failed_at)}
            </span>
          </div>
          <pre
            :if={failure.summary}
            class="mt-1 overflow-x-auto font-mono text-xs leading-relaxed text-base-content/80"
          >{failure.summary}</pre>
        </li>
      </ul>
    </div>
  </section>

  <section id="version-streaks" class="card mt-6 border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body">
      <div>
        <h2 class="card-title">Failing across versions</h2>
        <p class="mt-1 text-sm leading-6 text-base-content/70">
          Packages whose newest releases all failed, longest run first. A version counts by its
          latest build. The same category on every release points at the package or at something
          systemic on our side; a category that changes between releases is worth a closer look.
        </p>
      </div>
      <p :if={@version_streaks == []} class="mt-3 text-sm text-base-content/60">
        No package has failed on two releases in a row.
      </p>
      <div :if={@version_streaks != []} class="mt-3 overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Package</th>
              <th class="text-right">Failing</th>
              <th>Newest versions</th>
              <th>Last failed</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={entry <- @version_streaks} id={"streak-#{entry.package}"}>
              <td>
                <.link
                  navigate={~p"/packages/#{entry.package}"}
                  class="link font-mono font-medium"
                >
                  {entry.package}
                </.link>
              </td>
              <td class="text-right font-mono">
                {entry.streak} / {entry.versions_tested}
              </td>
              <td>
                <ul class="space-y-0.5">
                  <li :for={step <- entry.chain} class="flex flex-wrap items-center gap-2 text-xs">
                    <span class="font-mono">{step.version}</span>
                    <span class={[
                      "badge badge-xs",
                      if(step.status == :pass, do: "badge-success", else: "badge-error")
                    ]}>
                      {step.status}
                    </span>
                    <span :if={step.category} class="text-base-content/60">{step.category}</span>
                  </li>
                </ul>
              </td>
              <td class="whitespace-nowrap text-xs text-base-content/60">
                {format_datetime(entry.last_failed_at)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</.admin_layout>
