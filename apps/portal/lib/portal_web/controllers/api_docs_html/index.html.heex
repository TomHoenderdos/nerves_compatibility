<Layouts.app flash={@flash} active={:api} current_user={@current_user}>
  <section class="space-y-10">
    <PortalWeb.UI.page_header kicker="Developers" title={@info.title}>
      <:subtitle>
        <p :for={paragraph <- paragraphs(@info.description)} class="mt-2 first:mt-0">
          <.spec_text text={paragraph} />
        </p>
      </:subtitle>
    </PortalWeb.UI.page_header>

    <div id="api-docs-links" class="flex flex-wrap gap-3 text-sm">
      <a
        id="openapi-json-link"
        href={~p"/api/openapi.json"}
        class="rounded-md border border-base-300 bg-base-100 px-3 py-1.5 font-semibold transition hover:border-primary hover:text-primary"
      >
        OpenAPI document (JSON)
      </a>
      <a
        href={@precompiled_docs_url}
        class="rounded-md border border-base-300 bg-base-100 px-3 py-1.5 transition hover:border-primary hover:text-primary"
      >
        Precompiled API: matching and verification
      </a>
      <a
        href={@catalog_docs_url}
        class="rounded-md border border-base-300 bg-base-100 px-3 py-1.5 transition hover:border-primary hover:text-primary"
      >
        Catalog format
      </a>
    </div>

    <nav id="api-docs-toc" class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
      <div :for={section <- @sections} class="mb-4 last:mb-0">
        <a href={"#" <> section.id} class="text-sm font-semibold hover:text-primary">
          {section.name}
        </a>
        <ul class="mt-2 space-y-1">
          <li :for={op <- section.operations} class="text-sm">
            <a href={"#" <> op.id} class="group flex flex-wrap items-baseline gap-2">
              <span class="font-mono text-xs font-semibold text-primary">{op.method}</span>
              <span class="font-mono text-base-content/80 group-hover:text-primary">
                {op.path}
              </span>
              <span class="text-base-content/50">{op.summary}</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <section :for={section <- @sections} id={section.id} class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">{section.name}</h2>
        <p :if={section.description} class="mt-1 text-base-content/70">
          <.spec_text text={section.description} />
        </p>
      </div>

      <article
        :for={op <- section.operations}
        id={op.id}
        class="scroll-mt-6 space-y-5 rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm"
      >
        <header class="space-y-2">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-md bg-primary px-2 py-0.5 font-mono text-xs font-bold text-primary-content">
              {op.method}
            </span>
            <code class="break-all font-mono text-sm font-semibold">{op.path}</code>
          </div>
          <h3 class="text-lg font-semibold">{op.summary}</h3>
          <p :for={paragraph <- paragraphs(op.description)} class="text-base-content/70">
            <.spec_text text={paragraph} />
          </p>
        </header>

        <div :if={op.parameters != []} class="space-y-2">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
            Parameters
          </h4>
          <div class="overflow-x-auto rounded-xl border border-base-300">
            <table id={op.id <> "-params"} class="w-full text-left text-sm">
              <thead class="border-b border-base-300 bg-base-200/60 text-xs uppercase tracking-wide text-base-content/60">
                <tr>
                  <th class="px-4 py-2">Name</th>
                  <th class="px-4 py-2">In</th>
                  <th class="px-4 py-2">Type</th>
                  <th class="px-4 py-2">Description</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-base-200">
                <tr :for={param <- op.parameters} class="align-top">
                  <td class="whitespace-nowrap px-4 py-2 font-mono">
                    {param.name}
                    <span
                      :if={param.required}
                      class="ml-1 font-sans text-xs font-semibold text-primary"
                    >
                      required
                    </span>
                  </td>
                  <td class="px-4 py-2 text-base-content/70">{param.in}</td>
                  <td class="px-4 py-2 font-mono text-xs text-base-content/70">{param.type}</td>
                  <td class="px-4 py-2 text-base-content/70">
                    <.spec_text text={param.description} />
                    <span
                      :if={not is_nil(param.default)}
                      class="block text-xs text-base-content/50"
                    >
                      Default: <code class="font-mono">{to_string(param.default)}</code>
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="space-y-4">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-base-content/60">
            Responses
          </h4>
          <div :for={response <- op.responses} class="space-y-3">
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <span class={[
                "rounded-full px-2.5 py-0.5 font-mono text-xs font-semibold ring-1",
                status_class(response.status)
              ]}>
                {response.status}
              </span>
              <span class="font-medium">{response.description}</span>
              <code :if={response.content_type} class="font-mono text-xs text-base-content/50">
                {response.content_type}
              </code>
              <span :if={response.type} class="font-mono text-xs text-base-content/50">
                · {response.type}
              </span>
            </div>
            <p :if={response.headers != []} class="text-xs text-base-content/60">
              Headers:
              <code :for={header <- response.headers} class="mr-1 font-mono">{header}</code>
            </p>
            <p :if={response.schema_description} class="text-sm text-base-content/70">
              <.spec_text text={response.schema_description} />
            </p>
            <.field_table
              :if={response.fields != []}
              id={op.id <> "-" <> response.status <> "-fields"}
              fields={response.fields}
            />
          </div>
        </div>
      </article>
    </section>

    <section :if={@payloads != []} id="signed-payloads" class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Signed payloads</h2>
        <p class="mt-1 text-base-content/70">
          What the <code class="font-mono">payload</code>
          of a signed envelope decodes to, once its signatures verify.
        </p>
      </div>
      <article
        :for={payload <- @payloads}
        id={payload.id}
        class="space-y-3 rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm"
      >
        <h3 class="font-mono text-lg font-semibold">{payload.title}</h3>
        <p :if={payload.description} class="text-sm text-base-content/70">
          <.spec_text text={payload.description} />
        </p>
        <.field_table id={payload.id <> "-fields"} fields={payload.fields} />
      </article>
    </section>
  </section>
</Layouts.app>
