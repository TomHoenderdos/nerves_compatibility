# Example environment file for ncc-agent.service (mode 0600); copy it to the
# path its EnvironmentFile= points at.

# The portal's builder endpoint, an https URL with its mTLS port.
NCC_PORTAL_URL=https://portal.example.org:8443
# One-time enrolment token from the admin Builders tab; unused once enrolled.
NCC_ENROLMENT_TOKEN=
# Concurrent builds on this host, 1..16.
NCC_SLOTS=1
# docker --cpus for each build container; unset for no limit.
NCC_CPUS=4
# docker --memory for each build container; unset for no limit.
NCC_MEMORY=8g
# Identity, scratch, caches and releases live here.
NCC_DATA_DIR=/srv/ncc
# uid:gid the build containers run as (the unprivileged ncc-build user).
NCC_BUILD_USER=998:998
# The resolvers the egress ruleset lets build containers reach on port 53,
# space-separated; unset to find them (daemon.json, resolv.conf, resolvectl).
# NCC_DNS_SERVERS=10.0.0.2
