# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
nerves_compatibility-*.tar

# Generated static site
/public/

# Orchestrator DETS database files
*.dets

# Orchestrator runtime artifacts
orchestrator/orchestrator.log
/compat_test_results/

# ElixirLS
.elixir_ls/

# Claude Code local settings
.claude/

# Wrangler local cache (deploys via Cloudflare Pages)
.wrangler/

# Portal local SQLite databases and runtime state
portal/var/

# macOS
.DS_Store
.gstack/

# Operator host list for ops/deploy-builders.sh
/ops/builders.hosts

# Internal plans and specs live in their own private repository
/docs/superpowers/
/docs/talks/
__pycache__/

# Operator notes for Claude Code, kept out of the public repo
/CLAUDE.local.md
