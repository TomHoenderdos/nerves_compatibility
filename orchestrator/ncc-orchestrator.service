[Unit]
Description=Nerves Compatibility Orchestrator
Documentation=https://github.com/fhunleth/nerves_compatibility
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ncc
Group=ncc
WorkingDirectory=/opt/nerves_compatibility/orchestrator
Environment="HOME=/opt/nerves_compatibility"
Environment="MIX_ENV=prod"

# Ensure directories exist
ExecStartPre=/usr/bin/mkdir -p /var/lib/ncc/data
ExecStartPre=/usr/bin/mkdir -p /var/log/ncc
ExecStartPre=/usr/bin/chown -R ncc:ncc /var/lib/ncc /var/log/ncc

# Start the orchestrator
ExecStart=/opt/nerves_compatibility/orchestrator/ncc_orchestrator start

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ncc-orchestrator

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
